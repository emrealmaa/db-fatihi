# Geliştirme ortamı için örnek değerler. Kopyala: cp .env.example .env

# ---- Veritabanı sürücüsü
# pg     : gerçek PostgreSQL (Docker veya yerel kurulum)
# pglite : kurulum gerektirmeyen gömülü PostgreSQL (PGLITE_DIZINI boşsa bellekte)
DB_SURUCU=pg
PGLITE_DIZINI=db/.pglite

# ---- PostgreSQL bağlantısı
# Docker (make up DB=postgres): port 5433, yönetici kullanıcı aşağıdaki POSTGRES_USER.
# Yerel kurulum (Windows/Mac): port genelde 5432; PG_ADMIN_USER=postgres ve kurulumda verilen parola.
POSTGRES_HOST=localhost
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_pw
POSTGRES_DB=karavana
POSTGRES_PORT=5433
# Doluysa POSTGRES_USER/POSTGRES_PASSWORD yerine db:kur bunları kullanır
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=

MYSQL_ROOT_PASSWORD=root_dev_pw
MYSQL_USER=app
MYSQL_PASSWORD=app_dev_pw
MYSQL_DATABASE=projectdb
MYSQL_PORT=3306

MONGO_USER=admin
MONGO_PASSWORD=admin_dev_pw
MONGO_DB=projectdb
MONGO_PORT=27017

NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_pw
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# MSSQL: parola karmaşıklık kuralını sağlamalı
MSSQL_SA_PASSWORD=Dev_Passw0rd!
MSSQL_PORT=1433
